{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": { "driver": { "name": "ExampleScan", "informationUri": "https://example.invalid/scan", "rules": [
        { "id": "php/sql-injection", "shortDescription": { "text": "Query built from user-controlled input" }, "defaultConfiguration": { "level": "error" }, "properties": { "security-severity": "8.8", "tags": [ "security", "external/cwe/cwe-089" ] } },
        { "id": "php/hardcoded-credentials", "shortDescription": { "text": "Hard-coded credentials" }, "defaultConfiguration": { "level": "error" }, "properties": { "security-severity": "9.8", "tags": [ "security", "external/cwe/cwe-798" ] } },
        { "id": "php/unused-variable", "shortDescription": { "text": "Unused variable" }, "defaultConfiguration": { "level": "note" } } ] } },
      "results": [
        { "ruleId": "php/sql-injection", "ruleIndex": 0, "level": "error", "message": { "text": "This query depends on a user-provided value." }, "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "portal/projects/search.php" }, "region": { "startLine": 42, "startColumn": 18 } } } ] },
        { "ruleId": "php/sql-injection", "ruleIndex": 0, "level": "error", "message": { "text": "This query depends on a user-provided value." }, "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "portal/projects/search.php" }, "region": { "startLine": 77, "startColumn": 22 } } } ] },
        { "ruleId": "php/hardcoded-credentials", "ruleIndex": 1, "message": { "text": "A database password is written in the source code." }, "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "portal/config/db.php" }, "region": { "startLine": 9 } } } ] },
        { "ruleId": "php/unused-variable", "ruleIndex": 2, "level": "note", "message": { "text": "Variable $tmp is never used." }, "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "portal/lib/util.php" }, "region": { "startLine": 120 } } } ], "suppressions": [ { "kind": "inSource" } ] }
      ]
    }
  ]
}
