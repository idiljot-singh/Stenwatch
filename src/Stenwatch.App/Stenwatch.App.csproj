<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Stenwatch.Core\Stenwatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- the bundled Example Organisation and the documentation travel with the app -->
  <ItemGroup>
    <Content Include="..\..\examples\profile.example.yaml" Link="profile.example.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\assets.example.csv" Link="assets.example.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\third_parties.example.csv" Link="third_parties.example.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\exceptions.example.csv" Link="exceptions.example.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\services.example.csv" Link="services.example.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\asset_context.example.csv" Link="asset_context.example.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\links.example.csv" Link="links.example.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\controls.example.csv" Link="controls.example.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\pillars.md" Link="docs\pillars.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\evaluation.md" Link="docs\evaluation.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="docs\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="docs\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Stenwatch</AssemblyName>
    <RootNamespace>Stenwatch.App</RootNamespace>
    <ApplicationIcon>stenwatch.ico</ApplicationIcon>
    <Product>Stenwatch</Product>
    <Company>Diljot Singh Johal</Company>
    <Authors>Diljot Singh Johal</Authors>
    <Description>Threat-informed vulnerability management</Description>
    <Copyright>Copyright (c) 2026 Diljot Singh Johal</Copyright>
    <Version>0.2.0-beta</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
  </PropertyGroup>

</Project>
